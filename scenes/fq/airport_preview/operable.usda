#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World" (
    prepend references = @scene.usdc@</World>
)
{
    def Xform "MovableSwab" (
        prepend references = @../../../examples/airport_operations/legacy_rigid_swab.usdc@
    )
    {
        double3 xformOp:translate = (1.3, 0.95, 0.7925)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

