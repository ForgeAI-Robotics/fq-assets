        def Cube "StoneFloor" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
            customData = {
                string photoGroup = "environment"
                string sourceGeomName = "StoneFloor"
            }
        )
        {
            rel material:binding = </World/Materials/stone>
            double size = 2
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (20, 18, 0.08)
            double3 xformOp:translate = (0, -4, -0.08)
