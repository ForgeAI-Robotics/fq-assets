#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    subLayers = [
        @architecture.usda@
    ]
    upAxis = "Z"
)

over "World"
{
    def Xform "round_table" (
        prepend references = @../../../assets/fq/tabletop/isaac/round_table.usd@
    )
    {
        double3 xformOp:translate = (10.8, 11.55, -0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "coke" (
        prepend references = @../../../assets/fq/tabletop/isaac/coke.usd@
    )
    {
        double3 xformOp:translate = (10.8, 11.55, 0.8247)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "Meshes"
        {
            bool physics:rigidBodyEnabled = 0
        }
    }

    def Xform "refrigerator" (
        prepend references = @../../../assets/fq/haier_bcd402/refrigerator.usda@
    )
    {
        double3 xformOp:translate = (15.5, 11.9, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "Joints"
        {
            over "fixed_base"
            {
                point3f physics:localPos0 = (15.5, 11.9, 0)
            }
        }

        over "door_right"
        {
        }
    }

    over "meeting_cabinet" (
        active = false
    )
    {
    }

    over "meeting_cabinet_collision" (
        active = false
    )
    {
    }

    over "meeting_tabletop" (
        active = false
    )
    {
    }

    over "meeting_table_leg_0_0" (
        active = false
    )
    {
    }

    over "meeting_table_leg_0_1" (
        active = false
    )
    {
    }

    over "meeting_table_leg_1_0" (
        active = false
    )
    {
    }

    over "meeting_table_leg_1_1" (
        active = false
    )
    {
    }

    def Xform "meeting_table_v7" (
        prepend references = @../../../assets/fq/conference_table/table.usda@</World/meeting_table_v7>
    )
    {
    }

    over "meeting_table_collision" (
        active = false
    )
    {
    }

    def Xform "right_door_coke_1" (
        prepend references = @../../../assets/fq/tabletop/isaac/coke.usd@
    )
    {
        double3 xformOp:translate = (15.620000008, 11.708999994000001, 0.963590003)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "Meshes"
        {
            bool physics:rigidBodyEnabled = 1
        }
    }

    def Xform "right_door_coke_2" (
        prepend references = @../../../assets/fq/tabletop/isaac/coke.usd@
    )
    {
        double3 xformOp:translate = (15.720000008, 11.708999994000001, 0.963590003)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "Meshes"
        {
            bool physics:rigidBodyEnabled = 1
        }
    }
}

