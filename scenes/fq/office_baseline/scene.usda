#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    subLayers = [
        @architecture.usda@
    ]
    upAxis = "Z"
)

over "World"
{
    def Xform "round_table" (
        prepend references = @../../../assets/fq/tabletop/isaac/round_table.usd@
    )
    {
        double3 xformOp:translate = (10.8, 11.55, -0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "coke" (
        prepend references = @../../../assets/fq/tabletop/isaac/coke.usd@
    )
    {
        double3 xformOp:translate = (10.8, 11.55, 0.8594278971623001)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "Meshes"
        {
            bool physics:rigidBodyEnabled = 0
        }
    }

    def Xform "refrigerator" (
        prepend references = @../../../assets/fq/haier_bcd402/refrigerator.usda@
    )
    {
        double3 xformOp:translate = (16.5, 11.9, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "Joints"
        {
            over "fixed_base"
            {
                point3f physics:localPos0 = (16.5, 11.9, 0)
            }
        }
    }
}

