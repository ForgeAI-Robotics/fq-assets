#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "meeting_table_v7"
    {
        def "Looks"
        {
            def Material "wood"
            {
                token outputs:surface.connect = </World/meeting_table_v7/Looks/wood/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.65, 0.6, 0.5)
                    color3f inputs:diffuseColor.connect = </World/meeting_table_v7/Looks/wood/Texture.outputs:rgb>
                    color3f inputs:emissiveColor = (0, 0, 0)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.483589
                    float inputs:roughness.connect = </World/meeting_table_v7/Looks/wood/Roughness.outputs:r>
                    token outputs:surface
                }

                def Shader "Texture"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @textures/basecolor_v4.png@
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </World/meeting_table_v7/Looks/wood/UV.outputs:result>
                    token inputs:wrapS = "clamp"
                    token inputs:wrapT = "clamp"
                    color3f outputs:rgb
                }

                def Shader "UV"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "Roughness"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @textures/roughness_v4.png@
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </World/meeting_table_v7/Looks/wood/UV.outputs:result>
                    float outputs:r
                }
            }

            def Material "metal"
            {
                token outputs:surface.connect = </World/meeting_table_v7/Looks/metal/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.65, 0.65, 0.65)
                    float inputs:metallic = 1
                    float inputs:roughness = 0.38
                    token outputs:surface
                }
            }

            def Material "legs"
            {
                token outputs:surface.connect = </World/meeting_table_v7/Looks/legs/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.055, 0.06, 0.065)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.3
                    token outputs:surface
                }
            }
        }

