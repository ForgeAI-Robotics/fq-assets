            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "front_low" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.72, 0.77, 0.8)]
            double size = 1
            float3 xformOp:scale = (0.212, 0.004, 0.016)
            double3 xformOp:translate = (0, -0.041, 0.012)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "front_left" (
