#usda 1.0
(
    defaultPrim = "SupplyBox"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "SupplyBox"
{
    def Xform "Lid" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.08
        double3 xformOp:translate = (0, 0.043, 0.061)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "lid_panel" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.72, 0.77, 0.8)]
            double size = 1
            float3 xformOp:scale = (0.224, 0.09, 0.005)
            double3 xformOp:translate = (0, -0.043, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "lid_handle" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.06, 0.27, 0.5)]
            double size = 1
            float3 xformOp:scale = (0.036, 0.01, 0.006)
            double3 xformOp:translate = (0, -0.073, 0.005)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

