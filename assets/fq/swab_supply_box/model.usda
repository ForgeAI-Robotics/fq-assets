    def PhysicsRevoluteJoint "LidJoint" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
    )
    {
        float drive:angular:physics:damping = 0.2
        float drive:angular:physics:maxForce = 1
        float drive:angular:physics:stiffness = 5
        float drive:angular:physics:targetPosition = 0
        uniform token drive:angular:physics:type = "force"
        uniform token physics:axis = "X"
        rel physics:body1 = </SupplyBox/Lid>
        point3f physics:localPos0 = (0, 0.043, 0.061)
        point3f physics:localPos1 = (0, 0, 0)
        float physics:lowerLimit = -110
        float physics:upperLimit = 0
    }
