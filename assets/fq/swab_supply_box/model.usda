            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "right_wall" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.72, 0.77, 0.8)]
            double size = 1
            float3 xformOp:scale = (0.004, 0.086, 0.048)
