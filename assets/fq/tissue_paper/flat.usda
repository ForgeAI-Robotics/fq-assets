    def Material "Material"
    {
        token outputs:surface.connect = </Tissue/Material/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </Tissue/Material/diffuseColor.outputs:rgb>
            normal3f inputs:normal.connect = </Tissue/Material/normal.outputs:rgb>
            float inputs:roughness = 0.96
            color3f inputs:specularColor = (0.02, 0.02, 0.02)
            token outputs:surface
        }

        def Shader "ST"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "st"
            float2 outputs:result
        }

        def Shader "diffuseColor"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @tissue_fiber_color.png@
            token inputs:sourceColorSpace = "sRGB"
            float2 inputs:st.connect = </Tissue/Material/ST.outputs:result>
            float3 outputs:rgb
        }

        def Shader "normal"
        {
            uniform token info:id = "UsdUVTexture"
            float4 inputs:bias = (-1, -1, -1, 0)
            asset inputs:file = @tissue_fiber_normal.png@
            float4 inputs:scale = (2, 2, 2, 1)
            token inputs:sourceColorSpace = "raw"
            float2 inputs:st.connect = </Tissue/Material/ST.outputs:result>
            float3 outputs:rgb
        }
    }
}

