#usda 1.0
(
    defaultPrim = "IcedCoconutWaterBottle"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "IcedCoconutWaterBottle" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
)
{
    float physics:mass = 0.028
    point3f physics:centerOfMass = (0, 0, 0.139)
    float3 physics:diagonalInertia = (0.000178, 0.000179, 1.6e-05)
    rel material:binding:physics = </IcedCoconutWaterBottle/Materials/PET>
    def Scope "Materials"
    {
        def Material "PET" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:staticFriction = 0.5
            float physics:dynamicFriction = 0.45
            float physics:restitution = 0.1
        }
        def Material "shell"
        {
            token outputs:surface.connect = </IcedCoconutWaterBottle/Materials/shell/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.92, 0.94)
                float inputs:opacity = 0.27
                float inputs:roughness = 0.18
                token outputs:surface
            }
        }
        def Material "sleeve"
        {
            token outputs:surface.connect = </IcedCoconutWaterBottle/Materials/sleeve/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </IcedCoconutWaterBottle/Materials/sleeve/Tex.outputs:rgb>
                float inputs:opacity.connect = </IcedCoconutWaterBottle/Materials/sleeve/Tex.outputs:a>
                float inputs:opacityThreshold = 0.5
                float inputs:roughness = 0.37
                token outputs:surface
            }
            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "Tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @label.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </IcedCoconutWaterBottle/Materials/sleeve/UV.outputs:result>
                float3 outputs:rgb
                float outputs:a
            }
        }
        def Material "cap"
        {
            token outputs:surface.connect = </IcedCoconutWaterBottle/Materials/cap/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.34, 0.55, 0.02)
                float inputs:opacity = 1
                float inputs:roughness = 0.37
                token outputs:surface
            }
        }
    }
